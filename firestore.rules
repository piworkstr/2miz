rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(coupleId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // Herkes sadece kendi profilini okuyup yazabilir.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // Eşleşmiş partner profili okuyabilir (çift kimliği "davetEden_katılan" biçiminde).
      allow read: if signedIn() && (
        exists(/databases/$(database)/documents/couples/$(request.auth.uid + '_' + uid)) ||
        exists(/databases/$(database)/documents/couples/$(uid + '_' + request.auth.uid)));
    }

    // Davet kodları: kodu bilen okuyabilir, liste halinde görülemez.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn();
    }

    // Şikayetler: kullanıcı yazabilir ama okuyamaz; ekip Firebase konsolundan inceler.
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporter == request.auth.uid;
    }

    // Hata ve öneri bildirimleri (deneme kullanıcıları): herkes yazar; yalnızca kurucu çift okur ve "yapıldı" işaretler.
    function isFounder() {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/sskwX1vA0gMelkMEOodhISdZSVq1_vWx2gYuoPuWrDuUCAHXIHrz62et1).data.members;
    }
    match /feedback/{feedbackId} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow read: if isFounder();
      allow update: if isFounder() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // Avantajlar: anlaşmalı mekanlar. Herkes okur; yalnızca kurucu çift ekler ve değiştirir.
    match /partners/{partnerId} {
      allow read: if signedIn();
      allow write: if isFounder();
      // Mekana gelen çiftler (çift başına tek belge): çift kendi belgesini yazar, sayıları kurucu çift görür.
      match /visits/{coupleId} {
        allow create, update: if isMember(coupleId);
        allow read: if isFounder();
      }
    }
    // Mekanın kasa anahtarı: uygulama okuyamaz; damga kuralı kodu bununla doğrular.
    match /partnerSecrets/{partnerId} {
      allow read, write: if isFounder();
    }
    // Türkiye saatiyle bugün, sıfır dolgusuz ("2026-11-14"); uygulamadaki istDay() ile aynı.
    function istDay() {
      let n = request.time + duration.value(3, 'h');
      return string(n.year()) + '-' + string(n.month()) + '-' + string(n.day());
    }
    // Damga: kasa kodu doğruysa ve belge kimliği "mekan_s_bugün" ise geçer (çift başına mekanda günde bir damga).
    function stampOk(perkId) {
      let d = request.resource.data;
      let s = get(/databases/$(database)/documents/partnerSecrets/$(d.pid)).data;
      let day = istDay();
      let hash = hashing.sha256(s.key + ':' + (s.get('fixed', false) ? 'sabit' : day)).toHexString().lower();
      return d.day == day && perkId == d.pid + '_s_' + day && d.code == hash[0:6];
    }

    // Çift belgesi: sadece iki üye görebilir ve güncelleyebilir.
    match /couples/{coupleId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // plus alanını yalnızca ödeme sunucusu (yönetici anahtarı) yazar; uygulama kendine Plus veremez.
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && !('plus' in request.resource.data);
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.get('plus', null) == resource.data.get('plus', null);
      // Hesap silinirken çift belgesi de silinir.
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /days/{dayId} {
        allow read, write: if isMember(coupleId);
      }

      match /dates/{dateId} {
        allow read, write: if isMember(coupleId);
      }

      // Selfieler: sadece çiftin üyeleri görebilir; herkes yalnızca kendi fotoğrafını yazar.
      match /photos/{photoId} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.data.size() < 900000;
        // Hesap silinirken iki kişinin fotoğrafları da silinebilsin.
        allow delete: if isMember(coupleId);
      }

      // Aşk kuponları: yazan kişi oluşturur ve kaldırır, partneri puanla açar.
      match /coupons/{couponId} {
        allow read, update: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.owner == request.auth.uid;
        allow delete: if isMember(coupleId);
      }

      // Canlı oyunlar ve davetler.
      match /games/{gameId} {
        allow read, write: if isMember(coupleId);
      }

      // Hayal dünyaları: iki kişilik sahneler ve hayal defteri sayfaları.
      match /scenes/{sceneId} {
        allow read, update, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.by == request.auth.uid;
      }

      // Mesajlar: herkes yalnızca kendi adına yazar; şikayet için "hiddenFor" güncellenebilir.
      match /messages/{messageId} {
        allow read, update, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.from == request.auth.uid
          && request.resource.data.text.size() <= 1000;
      }
      match /messagePhotos/{photoId} {
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.from == request.auth.uid
          && request.resource.data.data.size() < 900000;
      }

      match /messageAudio/{audioId} {
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.from == request.auth.uid
          && request.resource.data.data.size() < 900000;
      }

      // Albüm baskı talepleri: üyeler oluşturur ve görür; durumu yalnızca UsDaily (Baskı Merkezi) değiştirir.
      match /albumOrders/{orderId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.by == request.auth.uid;
      }

      // Avantaj hareketleri (damga, ödül, indirim kodu): yalnızca oluşturulur; silinmez ve değişmez.
      match /perks/{perkId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.t in ['stamp', 'redeem', 'code']
          && (request.resource.data.t != 'stamp' || stampOk(perkId));
      }

      // Ortak takvim: planları iki üye de ekler ve siler.
      match /events/{eventId} {
        allow read, write: if isMember(coupleId);
      }
      // Telefon takviminden paylaşılan meşguliyetler: herkes yalnızca kendininkini yazar.
      match /busy/{uid} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && request.auth.uid == uid;
      }

      // "Yazıyor…" durumu: herkes yalnızca kendi belgesini yazar.
      match /presence/{uid} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && request.auth.uid == uid;
      }

      // Seyahat albümleri: iki üye de seyahat açar, fotoğraf ekler, not yazar ve silebilir.
      match /trips/{tripId} {
        allow read, write: if isMember(coupleId);
      }
      match /tripPhotos/{photoId} {
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.uid == request.auth.uid
          && request.resource.data.data.size() < 900000;
        // Not eklenebilir ama fotoğrafın kendisi ve sahibi değişmez.
        allow update: if isMember(coupleId)
          && request.resource.data.data == resource.data.data
          && request.resource.data.uid == resource.data.uid;
      }
    }
  }
}
