{
  "expo": {
    "name": "2miz",
    "slug": "usdaily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ikimiz.couples",
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.usdaily.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "2miz, görevleri tamamlarken ve partnerine anlık fotoğraf gönderirken kamerayı kullanır.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F3"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ED1C24"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "2miz, seyahat albümünüze ve profil fotoğrafına eklemek için yalnızca seçtiğin fotoğraflara erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "2miz, partnerine sesli mesaj gönderebilmen için mikrofonu yalnızca sen kayda basılı tutarken kullanır."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "2miz, telefon takvimindeki işlerini partnerinle paylaşmayı seçersen takvimini okur. Takvimine bir şey yazmaz.",
          "remindersPermission": false
        }
      ]
    ],
    "scheme": "usdaily",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "61b32801-60da-4f82-8f2a-a26940aaf8df"
      }
    },
    "owner": "tanerbentesens-team",
    "updates": {
      "url": "https://u.expo.dev/61b32801-60da-4f82-8f2a-a26940aaf8df",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
